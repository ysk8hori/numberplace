{
  "name": "numberplace",
  "private": true,
  "version": "2.6.0",
  "homepage": "https://ysk8hori.github.io/numberplace/",
  "packageManager": "pnpm@11.28.13+sha512.d5caa9cdcd6067ac2902f9f44daa00b1288a73babf1e98f4f375b3a7583b1894b4d49f7527da8f5e1530198bb10e03adba321a1f015429dc2946ce8a7a9a8c65",
  "scripts": {
    "wasm:setup": "mkdir -p vendor && ( [ -d vendor/numberplace-generator-wasm/.git ] && git -C vendor/numberplace-generator-wasm pull --ff-only || git clone https://github.com/ysk8hori/numberplace-generator-wasm.git vendor/numberplace-generator-wasm )",
    "wasm:build": "pnpm run wasm:setup && cd vendor/numberplace-generator-wasm/rust-src && wasm-pack build --target web",
    "postinstall": "pnpm run wasm:build",
    "dev": "pnpm run wasm:build && vite",
    "build": "pnpm run wasm:build && tsc && vite build",
    "build:ghpages": "pnpm run wasm:build && tsc && vite build --base=/numberplace/",
    "preview": "pnpm run wasm:build && tsc && vite build && vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "prettier": "prettier --write ./src ./.storybook",
    "type-check": "pnpm run wasm:build && tsc --noEmit",
    "test:run": "pnpm run wasm:build && vitest run",
    "check": "pnpm run type-check && pnpm run lint && pnpm run test:run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:test": "test-storybook",
    "storybook:test:watch": "test-storybook --watch",
    "storybook:test:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"pnpm run storybook\" \"wait-on tcp:6006 && pnpm run storybook:test\"",
    "deploy:numberp.test": "aws s3 sync ./dist s3://numberp.test --region ap-northeast-1 --delete",
    "chromatic": "npx chromatic --project-token=1d1cac2951ec --patch-build=ysk8hori-patch-2...main"
  },
  "dependencies": {
    "@sentry/browser": "10.65.0",
    "@sentry/react": "10.65.0",
    "@sentry/tracing": "7.120.4",
    "@tanstack/react-query": "5.108.1",
    "@ysk8hori/numberplace-generator": "3.0.2",
    "clsx": "2.1.1",
    "jotai": "2.20.3",
    "jotai-optics": "0.4.0",
    "optics-ts": "2.4.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "5.5.0",
    "reflect-metadata": "0.2.2",
    "smart-svg": "1.1.6",
    "styled-components": "6.0.9",
    "usehooks-ts": "3.1.1"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@chromatic-com/storybook": "5.0.1",
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.0.6",
    "@storybook/addon-links": "10.0.6",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.1",
    "@storybook/preset-scss": "1.0.3",
    "@storybook/react-vite": "10.0.6",
    "@storybook/test": "8.6.14",
    "@storybook/test-runner": "^0.24.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/styled-components": "5.1.36",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/ui": "latest",
    "autoprefixer": "10.7.0",
    "babel-loader": "10.1.1",
    "chromatic": "13.3.5",
    "concurrently": "9.2.5",
    "css-loader": "7.1.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.8",
    "globals": "17.14.0",
    "http-server": "14.1.1",
    "jsdom": "latest",
    "playwright": "1.65.1",
    "postcss": "8.5.33",
    "postcss-import": "16.2.0",
    "postcss-loader": "8.2.1",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "sass-loader": "16.0.8",
    "storybook": "10.2.13",
    "style-loader": "4.0.0",
    "tailwindcss": "3.4.19",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0",
    "typescript7": "npm:typescript@7.0.2",
    "use-interval": "1.4.0",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12",
    "wait-on": "9.5.1"
  }
}
